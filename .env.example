# ── Google Gemini ──────────────────────────────────────────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── TheSportsDB ────────────────────────────────────────────────────────────────
# Free test key (v1 endpoints): use "3"  — no sign-up required for read-only test
# Full key (v2 / more endpoints): https://www.thesportsdb.com/api.php
SPORTS_DB_API_KEY=

# ── App settings (optional tweaks) ─────────────────────────────────────────────
# LLM model name (default: gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash
# Host / port for uvicorn
APP_HOST=127.0.0.1
APP_PORT=8000
